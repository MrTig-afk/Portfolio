---
import { SITE } from "../lib/site";
---
<nav class="bar" aria-label="Contact">
  <a href={`mailto:${SITE.contact.email}`} data-event="email">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2" /><path d="M3.8 7l8.2 6 8.2-6" /></svg>
    Email
  </a>
  <a href={SITE.contact.linkedin} target="_blank" rel="noopener" data-event="linkedin">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="3" /><path d="M8 10.5v6M8 7.6v.1M11.5 16.5v-6M11.5 13c0-1.6 1.1-2.6 2.5-2.6s2.5 1 2.5 2.6v3.5" stroke-linecap="round" /></svg>
    LinkedIn
  </a>
  <a class="pri" href="/kaushik-narumanchi.vcf" download data-event="save_contact">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="8.5" r="3.5" /><path d="M3.5 19.5c.8-3.3 3.4-5 6.5-5s5.7 1.7 6.5 5M18.5 8v6M15.5 11h6" /></svg>
    Save contact
  </a>
</nav>
