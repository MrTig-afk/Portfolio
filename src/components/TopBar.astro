---
import { SITE } from "../lib/site";
interface Props { current?: string }
const { current } = Astro.props;
const nav = [["About", "/about"], ["Portfolio", "/work"], ["Notes", "/notes"]];
const isHome = Astro.url.pathname === "/";
---
<header class="top">
  <div class="wrap">
    <div class="left">
      {!isHome && (
        <a class="home-ic" href="/" aria-label="Home" title="Home">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 11 12 4l8.5 7" /><path d="M5.5 9.5V20h13V9.5" /></svg>
        </a>
      )}
      <a class="name" href="/"><span class="short">Kaushik N.</span><span class="long">Kaushik Narumanchi</span></a>
    </div>
    <nav aria-label="Primary">
      {nav.map(([label, href]) => <a href={href} aria-current={label === current ? "page" : undefined}>{label}</a>)}
    </nav>
    <div class="acts">
      <button class="ibtn" type="button" data-theme-toggle hidden aria-label="Switch to dark theme">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.2A8 8 0 1 1 9.8 4a6.4 6.4 0 0 0 10.2 10.2z" /></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg>
      </button>
      <a class="tlink" href={SITE.contact.linkedin} target="_blank" rel="noopener" data-event="linkedin">LinkedIn</a>
      <a class="btn solid" href={`mailto:${SITE.contact.email}`} data-event="email">Email me</a>
    </div>
  </div>
</header>
