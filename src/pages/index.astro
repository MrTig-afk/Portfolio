---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { HOME } from "../lib/site";
const featured = (await getCollection("projects", (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order);
const total = (await getCollection("projects")).length;
---
<Base title="Kaushik Narumanchi" description="AI and backend engineer in Melbourne. Case studies of the systems I build and run: MingleHub, NutriScan, Claude Remote and more.">
  <section class="wrap hero">
    <div class="copy">
      <div class="kick">AI &amp; Backend Engineer · Melbourne</div>
      <h1>{HOME.statement}</h1>
      {HOME.statementIsPlaceholder && <span class="tag">placeholder line</span>}
      <div class="avail">Open to full-time roles from December 2026</div>
    </div>
    <div class="video" data-intro>
      {HOME.video
        ? <>
            <video src={HOME.video.src} poster={HOME.video.poster} muted playsinline preload="metadata" aria-label="A 30 second introduction from Kaushik">
              <track kind="captions" src={HOME.video.captions} srclang="en" label="English" default />
            </video>
            <button class="play" type="button" aria-label="Play the introduction with sound"></button>
          </>
        : <>
            <div class="sil" aria-hidden="true"></div>
            <span class="ph-mark">30 s intro</span>
            <button class="play" type="button" disabled aria-label="Introduction video coming soon"></button>
            <div class="ph-note"><span>video coming soon</span><span>0:30</span></div>
          </>}
    </div>
  </section>
  <section class="wrap sec">
    <div class="sec-head"><h2>Selected work</h2><span class="kick">{featured.length} of {total}</span></div>
    <div class="plist three">{featured.map((p) => <ProjectCard project={p} />)}</div>
    <a class="more" href="/work">All work and open source →</a>
  </section>
</Base>
