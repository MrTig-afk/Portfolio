---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="Nothing lives at this address.">
  <div class="wrap ph1 pb">
    <span class="kick">404</span>
    <h1>Nothing lives at this address.</h1>
    <p>The link may be old, or mistyped.</p>
    <div class="row mt"><a class="btn solid" href="/">Go to home</a><a class="btn" href="/work">See my work</a></div>
  </div>
</Base>
